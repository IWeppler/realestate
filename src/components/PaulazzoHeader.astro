---
interface Props { solid?: boolean; home?: string; }
const { solid = false, home = '' } = Astro.props;
---
<header class:list={["site-header", "container", { "detail-header": solid }]}>
        <a class="brand" href={`${home}#inicio`} aria-label="Belén Paulazzo Inmobiliaria, inicio"><img src="/paulazzo/logo.png" width="387" height="85" alt="Belén Paulazzo Inmobiliaria" /></a>
        <nav class="desktop-nav" aria-label="Navegación principal"><a href={`${home}#propiedades`}>Propiedades</a><a href={`${home}#nosotros`}>La inmobiliaria</a><a href={`${home}#propietarios`}>Soy propietario</a></nav>
        <a class="header-contact" href={`${home}#contacto`}>Conversemos <span class="action-arrow" aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-controls="paulazzo-mobile-navigation" aria-expanded="false"><span class="menu-label">Menú</span><span class="menu-close-label">Cerrar</span><span class="menu-icon" aria-hidden="true"></span></summary>
          <div class="mobile-menu-panel" id="paulazzo-mobile-navigation">
            <img class="mobile-menu-logo" src="/paulazzo/logo.png" width="387" height="85" alt="Belén Paulazzo Inmobiliaria" />
            <nav aria-label="Navegación móvil">
              <a href={`${home}#propiedades`}>Propiedades <span class="action-arrow" aria-hidden="true">↗</span></a>
              <a href={`${home}#nosotros`}>La inmobiliaria <span class="action-arrow" aria-hidden="true">↗</span></a>
              <a href={`${home}#propietarios`}>Soy propietario <span class="action-arrow" aria-hidden="true">↗</span></a>
            </nav>
            <div class="mobile-menu-contact">
              <p>Tu próximo lugar, en Carlos Paz.</p>
              <a class="button dark" href={`${home}#contacto`}>Conversemos <span class="action-arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </details>
      </header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu')!;
  const trigger = menu.querySelector<HTMLElement>('summary')!;
  const syncMenu = () => {
    trigger.setAttribute('aria-expanded', String(menu.open));
    document.documentElement.classList.toggle('paulazzo-menu-open', menu.open);
    document.querySelectorAll<HTMLElement>('body > :not(header), .hero, .hero-caption, .site-header > :not(.mobile-menu)').forEach(element => {
      // El header está dentro del hero en la landing y directamente en body en las fichas.
      if (!element.contains(menu)) element.inert = menu.open;
    });
  };
  menu.addEventListener('toggle', syncMenu);
  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; syncMenu(); }));
  document.addEventListener('keydown', event => {
    if (!menu.open) return;
    if (event.key === 'Escape') { menu.open = false; syncMenu(); trigger.focus(); }
    if (event.key === 'Tab') {
      const controls = [trigger, ...menu.querySelectorAll<HTMLElement>('a')];
      const first = controls[0], last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }
  });
  window.matchMedia('(min-width: 761px)').addEventListener('change', event => {
    if (event.matches) { menu.open = false; syncMenu(); }
  });
</script>
