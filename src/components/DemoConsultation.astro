---
import ActionLink from './ActionLink.astro';
---
<dialog id="consulta" class="demo-dialog" aria-labelledby="demo-dialog-title" data-lenis-prevent>
  <form method="dialog"><button class="dialog-close" aria-label="Cerrar">×</button></form>
  <p class="section-label">Sitio de demostración</p><h2 id="demo-dialog-title">Este estudio es ficticio.</h2>
  <p>Esta consulta forma parte del ejemplo y no se envía a un estudio real. Si querés una página para tu proyecto, podés conocer mi trabajo.</p>
  <ActionLink href="https://ignacioweppler.dev" variant="primary">Ver portfolio de Ignacio</ActionLink>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#consulta');
  let trigger: HTMLAnchorElement | null = null;
  document.addEventListener('click', event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href="#consulta"]') : null;
    if (!link || !dialog || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    trigger = link;
    dialog.showModal();
  }, true);
  dialog?.addEventListener('close', () => { trigger?.focus({ preventScroll: true }); });
  dialog?.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
</script>
