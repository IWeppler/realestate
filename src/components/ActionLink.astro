---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  tone?: 'default' | 'light';
  icon?: 'arrow' | 'down' | 'back';
  compact?: boolean;
  class?: string;
}
const { href, variant = 'secondary', tone = 'default', icon = 'arrow', compact = false, class: className } = Astro.props;
const paths = { arrow: 'M5 15 15 5M5 5h10v10', down: 'M10 3v14M4 11l6 6 6-6', back: 'M17 10H3M9 4l-6 6 6 6' };
---
<a href={href} class:list={['action', `action--${variant}`, { 'action--light': tone === 'light', 'action--compact': compact }, className]}>
  <span class="action__label"><slot /></span>
  <svg class:list={['action__icon', `action__icon--${icon}`]} width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[icon]} /></svg>
</a>
