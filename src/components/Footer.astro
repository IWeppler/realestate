---
import Brand from './Brand.astro';
interface Props { name?: string; home?: string; }
const { name = 'Ladera', home = '/ladera/' } = Astro.props;
---
<footer class="site-footer wrap">
  <div class="footer-top">
    <a class="footer-brand" href={home} aria-label={`${name}, inicio`}><Brand name={name} /></a>
    <a class="footer-instagram" href="https://www.instagram.com/ignacioweppler/" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {name}</p>
    <a class="developer-credit" href="https://ignacioweppler.dev" target="_blank" rel="noopener noreferrer">Developed by <span class="developer-name">Ignacio Weppler</span> <span class="credit-arrow" aria-hidden="true">↗</span></a>
  </div>
</footer>
