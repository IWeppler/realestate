---
interface Props { name: 'location' | 'area' | 'bed' | 'bath'; }
const { name } = Astro.props;
---
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {name === 'location' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'area' && <><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m7 17 10-10M7 12v5h5M12 7h5v5"/></>}
  {name === 'bed' && <><path d="M3 18v3m18-3v3M3 13V5h18v8M2 18v-5h20v5H2Z"/><path d="M6 13V9h5v4m2 0V9h5v4"/></>}
  {name === 'bath' && <><path d="M3 12h18v3a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-3Zm2 0V5a3 3 0 0 1 6 0M8 6h5M6 20v2m12-2v2"/></>}
</svg>
