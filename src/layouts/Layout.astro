---
import '../styles/global.css';
import '../styles/showcase.css';
import Motion from '../components/Motion.astro';
interface Props { title?: string; description?: string; intro?: boolean; }
const { title = 'Ladera — Arquitectura para habitar mejor', description = 'Ejemplo de sitio web para un estudio ficticio de arquitectura residencial e interiorismo en Guatemala. Diseñado y desarrollado por Ignacio Weppler.', intro = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102930" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/archivo-medium.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
    {intro && <script is:inline>
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const navigation = performance.getEntriesByType('navigation')[0];
        let seen = false;
        try { seen = sessionStorage.getItem('ladera:entry-seen') === '1'; } catch {}
        if (reduced || location.hash || navigation?.type === 'back_forward' || (seen && navigation?.type !== 'reload')) return;
        document.documentElement.classList.add('ladera-entering');
        // The page stays accessible even if the enhancement cannot initialize.
        window.setTimeout(() => {
          if (!document.documentElement.classList.contains('ladera-entering')) return;
          document.documentElement.classList.remove('ladera-entering', 'ladera-revealing');
          document.querySelector('.ladera-page')?.removeAttribute('inert');
          window.dispatchEvent(new Event('ladera:entry-end'));
        }, 4000);
      })();
    </script>}
  </head>
  <body><a class="skip-link" href="#contenido">Saltar al contenido</a><slot /><Motion /></body>
</html>
