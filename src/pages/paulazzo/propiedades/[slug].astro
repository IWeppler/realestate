---
import '../../../styles/paulazzo.css';
import '../../../styles/paulazzo-refinements.css';
import '../../../styles/paulazzo-detail.css';
import '../../../styles/paulazzo-brand.css';
import PaulazzoHeader from '../../../components/PaulazzoHeader.astro';
import PaulazzoFooter from '../../../components/PaulazzoFooter.astro';
import { properties } from '../../../data/paulazzo';

export function getStaticPaths() {
  return properties.map(property => ({ params: { slug: property.slug }, props: { property } }));
}
const { property } = Astro.props;
const related = properties.filter(item => item.slug !== property.slug);
const consultation = `https://wa.me/5493541336769?text=${encodeURIComponent(`Hola, me interesa ${property.title}. Quisiera recibir más información y coordinar una visita. ${property.source}`)}`;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06b2bc" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={`${property.title}. ${property.detail}. ${property.price}. Conocé las fotos y consultá con Belén Paulazzo Inmobiliaria.`} />
    <meta property="og:title" content={`${property.title} — Paulazzo`} />
    <meta property="og:description" content={property.description} />
    <title>{property.title} — Paulazzo</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/paulazzo/geist-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="property-page">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <PaulazzoHeader solid home="/paulazzo/" />
    <main id="contenido">
      <div class="container detail-intro">
        <nav class="breadcrumbs" aria-label="Ubicación en el sitio"><a href="/paulazzo/">Inicio</a><span aria-hidden="true">/</span><a href="/paulazzo/#propiedades">Propiedades</a><span aria-hidden="true">/</span><span>{property.category}</span></nav>
        <div class="detail-heading"><div><p class="detail-category"><span></span>{property.category} en venta · Villa Carlos Paz</p><h1>{property.title}</h1><p class="detail-address"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.4"/></svg>{property.address}</p></div><div class="share-action"><button type="button" id="share-property">Compartir <span class="action-arrow" aria-hidden="true">↗</span></button><span id="share-status" role="status" aria-live="polite"></span></div></div>
      </div>

      <section class="container detail-gallery" aria-label="Fotos de la propiedad" data-gallery-images={JSON.stringify(property.gallery)}>
        <div class="photo-mosaic">{property.gallery.slice(0, 5).map((photo, index) => <a href={photo.src} class:list={['mosaic-photo', { 'mosaic-main': index === 0 }]} data-gallery-index={index} aria-label={`Abrir foto ${index + 1}: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width="1600" height="1100" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} /><span class="action-arrow" aria-hidden="true">↗</span></a>)}</div>
        <button type="button" class="all-photos" data-gallery-index="0"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>Ver las {property.gallery.length} fotos</button>
      </section>

      <div class="container property-layout">
        <div class="property-content">
          <div class="key-facts" aria-label="Características principales"><div><strong>{property.area}</strong><span>{property.type === 'casa' ? 'cubiertos' : 'superficie'}</span></div><div><strong>{property.bedrooms}</strong><span>{property.bedrooms === '1' ? 'dormitorio' : 'dormitorios'}</span></div><div><strong>{property.bathrooms}</strong><span>{property.bathrooms === '1' ? 'baño' : 'baños'}</span></div>{property.land && <div><strong>{property.land}</strong><span>de terreno</span></div>}</div>
          <section class="detail-section" aria-labelledby="about-title"><p class="section-note">Para imaginar tu día a día</p><h2 id="about-title">{property.subtitle}</h2>{property.paragraphs.map(paragraph => <p class="detail-paragraph">{paragraph}</p>)}</section>
          <section class="detail-section" aria-labelledby="features-title"><h2 id="features-title">Lo que hace a este lugar.</h2><ul class="amenities">{property.features.map(feature => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul></section>
          <section class="detail-section" aria-labelledby="facts-title"><h2 id="facts-title">La propiedad, en detalle.</h2><dl class="property-facts">{property.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl><div class="property-conditions"><h3>Para tener en cuenta</h3><p>{property.conditions}</p></div></section>
          <section class="detail-section location-section" aria-labelledby="location-title"><h2 id="location-title">El entorno también cuenta.</h2><div class="property-map"><img src="/paulazzo/VCP.png" alt="El lago y el entorno serrano de Villa Carlos Paz." width="1672" height="941" loading="lazy" /><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(property.mapQuery)}`} target="_blank" rel="noopener noreferrer">Explorar la zona en Google Maps <span class="action-arrow" aria-hidden="true">↗</span></a></div><h3>{property.address}</h3><p class="location-note">{property.locationNote}</p></section>
        </div>

        <aside class="enquiry-sidebar" aria-labelledby="enquiry-title"><div class="enquiry-card"><p class="section-note">Precio de venta</p><p class="enquiry-price">{property.price}</p><span class="enquiry-type">{property.category} · {property.location.split(',')[0]}</span><div class="enquiry-divider"></div><h2 id="enquiry-title">¿Te imaginás viviendo acá?</h2><p>Conversemos sobre esta propiedad y coordinemos una visita.</p><a class="button dark" href={consultation} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <span class="action-arrow" aria-hidden="true">↗</span></a><a class="call-property" href="tel:+543541336769">O llamanos al 3541 336769</a><div class="advisor-signature"><span class="advisor-symbol" aria-hidden="true">↗</span><div><strong>Belén Paulazzo</strong><span>Inmobiliaria · MP CPI 6166</span></div></div><p class="availability-note">Precio, características y disponibilidad sujetos a confirmación con la inmobiliaria.</p></div><a class="original-listing" href={property.source} target="_blank" rel="noopener noreferrer">Consultar la publicación original <span class="action-arrow" aria-hidden="true">↗</span></a></aside>
      </div>

      <section class="detail-contact" id="consulta"><div class="container detail-contact-grid"><div><p class="section-note">Cada búsqueda empieza con una conversación</p><h2>Hablemos de<br />tu próximo lugar.</h2><p>Dejanos tu pregunta preparada.<br />La revisás y la enviás por WhatsApp.</p></div><form id="property-enquiry" data-property-title={property.title} data-property-source={property.source}><label>Tu nombre<input name="name" autocomplete="name" placeholder="¿Cómo te llamás?" required maxlength="100" /></label><label>¿Qué te gustaría saber?<textarea name="message" rows="3" required maxlength="1500">{`Hola, me interesa ${property.title.toLowerCase()}. Quisiera conocer más detalles y coordinar una visita.`}</textarea></label><button type="submit" class="button light">Continuar en WhatsApp <span class="action-arrow" aria-hidden="true">↗</span></button><p class="enquiry-form-note">El mensaje no se envía automáticamente.</p><a id="enquiry-fallback" class="enquiry-fallback" href={consultation} target="_blank" rel="noopener noreferrer" hidden>Abrir mi mensaje en WhatsApp ↗</a></form></div></section>

      <section class="container related-section" aria-labelledby="related-title"><div class="related-heading"><div><p class="section-note">Seguí imaginando</p><h2 id="related-title">Otros lugares para vos.</h2></div><a class="text-link" href="/paulazzo/#propiedades">Volver a la selección <span class="action-arrow" aria-hidden="true">↗</span></a></div><div class="related-properties">{related.map(item => <a class="related-property" href={item.path}><div><img src={`/paulazzo/${item.image}`} alt={item.alt} width="900" height="650" loading="lazy" /><span class="action-arrow" aria-hidden="true">↗</span></div><p>{item.location}</p><h3>{item.title}</h3><div class="related-meta"><span>{item.detail}</span><strong>{item.price}</strong></div></a>)}</div></section>
    </main>
    <PaulazzoFooter />
    <div class="mobile-property-action"><div><span>Precio de venta</span><strong>{property.price}</strong></div><a class="button dark" href={consultation} target="_blank" rel="noopener noreferrer">Consultar <span class="action-arrow" aria-hidden="true">↗</span></a></div>

    <dialog class="property-lightbox" aria-label="Galería de fotos de la propiedad"><div class="lightbox-top"><span class="lightbox-counter" aria-live="polite"></span><button class="lightbox-close" type="button" aria-label="Cerrar galería">Cerrar <span aria-hidden="true">×</span></button></div><div class="lightbox-stage"><button class="lightbox-prev" type="button" aria-label="Foto anterior">←</button><img class="lightbox-image" alt="" /><button class="lightbox-next" type="button" aria-label="Foto siguiente">→</button></div><p class="lightbox-caption"></p><div class="lightbox-thumbnails" aria-label="Elegir una foto"></div></dialog>
    <script>
      import '../../../scripts/paulazzo-detail';
    </script>
  </body>
</html>
