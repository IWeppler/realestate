---
export function getStaticPaths() {
  const pages = import.meta.glob('../../data/castas/**/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.entries(pages).map(([file, html]) => ({
    params: { path: file.replace('../../data/castas/', '').replace(/(?:^|\/)index\.html$/, '') || undefined },
    props: { html },
  }));
}
const { html } = Astro.props;
---
<Fragment set:html={html} />
